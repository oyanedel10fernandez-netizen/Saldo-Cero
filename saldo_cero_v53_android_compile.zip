name: V53 Verify Backend and Android

on:
  workflow_dispatch:
  push:
    branches: [ main, master ]

permissions:
  contents: read

jobs:
  backend:
    name: Backend V53
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v5

      - name: Extract V53
        shell: bash
        run: |
          set -euo pipefail
          test -f saldo_cero_v53_android_compile.zip
          rm -rf v53
          mkdir -p v53
          unzip -q saldo_cero_v53_android_compile.zip -d v53

      - name: Locate project
        shell: bash
        run: |
          set -euo pipefail

          PROJECT_ROOT="$(find v53 -type f -name 'V53_STATUS.md' -print -quit | xargs -r dirname)"

          test -n "$PROJECT_ROOT"
          test -d "$PROJECT_ROOT/backend"

          echo "PROJECT_ROOT=$PROJECT_ROOT" >> "$GITHUB_ENV"

      - uses: actions/setup-node@v5
        with:
          node-version: '22'

      - name: Backend install
        working-directory: ${{ env.PROJECT_ROOT }}/backend
        run: |
          npm install --ignore-scripts --no-audit --no-fund

      - name: Backend build
        working-directory: ${{ env.PROJECT_ROOT }}/backend
        run: |
          npm run build

      - name: Backend verification
        working-directory: ${{ env.PROJECT_ROOT }}/backend
        run: |
          npm run verify:v53

      - name: Backend evidence
        working-directory: ${{ env.PROJECT_ROOT }}/backend
        shell: bash
        run: |
          set -euo pipefail

          test -f dist/server.js

          mkdir -p ../artifacts

          echo "BACKEND_V53=PASS" | tee ../artifacts/backend-pass-v53.txt

      - uses: actions/upload-artifact@v4
        with:
          name: backend-pass-evidence-v53
          if-no-files-found: error
          retention-days: 14
          path: ${{ env.PROJECT_ROOT }}/artifacts/backend-pass-v53.txt


  android:
    name: Android V53 APK + AAB
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v5

      - name: Extract V53
        shell: bash
        run: |
          set -euo pipefail

          test -f saldo_cero_v53_android_compile.zip

          rm -rf v53
          mkdir -p v53

          unzip -q saldo_cero_v53_android_compile.zip -d v53

      - name: Locate project
        shell: bash
        run: |
          set -euo pipefail

          PROJECT_ROOT="$(find v53 -type f -name 'V53_STATUS.md' -print -quit | xargs -r dirname)"

          test -n "$PROJECT_ROOT"
          test -d "$PROJECT_ROOT/android"

          echo "PROJECT_ROOT=$PROJECT_ROOT" >> "$GITHUB_ENV"

      - uses: actions/setup-java@v5
        with:
          distribution: temurin
          java-version: '21'

      - name: Setup Gradle 8.9
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: '8.9'

      - name: Android debug APK
        working-directory: ${{ env.PROJECT_ROOT }}/android
        run: |
          gradle --no-daemon clean assembleDebug

      - name: Android release AAB
        working-directory: ${{ env.PROJECT_ROOT }}/android
        run: |
          gradle --no-daemon bundleRelease

      - name: Verify APK + AAB
        working-directory: ${{ env.PROJECT_ROOT }}/android
        shell: bash
        run: |
          set -euo pipefail

          APK="$(find app/build/outputs -type f -name '*.apk' | head -1)"
          AAB="$(find app/build/outputs -type f -name '*.aab' | head -1)"

          test -n "$APK"
          test -n "$AAB"

          mkdir -p artifacts

          cp "$APK" artifacts/
          cp "$AAB" artifacts/

          {
            echo "V53_ANDROID_BUILD=PASS"
            echo "APK=$(basename "$APK")"
            echo "AAB=$(basename "$AAB")"
            echo "APK_SHA256=$(sha256sum "$APK" | awk '{print $1}')"
            echo "AAB_SHA256=$(sha256sum "$AAB" | awk '{print $1}')"
          } | tee artifacts/release-evidence-v53.txt

      - uses: actions/upload-artifact@v4
        with:
          name: saldo-cero-v53-android
          if-no-files-found: error
          retention-days: 14
          path: ${{ env.PROJECT_ROOT }}/android/artifacts/
